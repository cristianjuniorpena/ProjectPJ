# Banco de dados
DATABASE_URL=postgresql+psycopg://userprojectpj:SUA_SENHA@localhost:5432/platform_pj

# JWT
ALGORITHM=HS256
# Gere a sua com: openssl rand -hex 32
SECRET_KEY=substitua_por_uma_chave_aleatoria_de_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Hash Argon2 descartavel, usado para gastar o mesmo tempo de verificacao
# quando o e-mail informado no login nao existe (defesa contra timing attack).
# Nao e uma credencial: nenhuma senha real corresponde a ele.
# Para gerar outro:
#   python -c "import secrets; from pwdlib import PasswordHash; print(PasswordHash.recommended().hash(secrets.token_urlsafe(32)))"
DUMMY_HASH=$argon2id$v=19$m=65536,t=3,p=4$eXW6IrMrTmk2lszB+165xg$lq3iaTg4g+eMbFEXUD7VZ9klKRbpX8pHpmh8Qo49CJE
